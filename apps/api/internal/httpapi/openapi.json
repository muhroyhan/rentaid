              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required for browser login and cookie-authenticated state changes.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Browser clients obtain a login CSRF token first. Android receives a bearer token and no cookie. Admin accounts are restricted to the admin client."
      }
    },
