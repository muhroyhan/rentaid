{
  "name": "rentaid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "db:up": "docker compose -f infra/compose.yaml up -d --wait postgres",
    "db:down": "docker compose -f infra/compose.yaml down",
    "api:dev": "go -C apps/api run ./cmd/rentaid serve",
    "api:build": "node scripts/build-api.mjs",
    "db:migrate": "go -C apps/api run ./cmd/rentaid migrate",
    "db:seed": "go -C apps/api run ./cmd/rentaid seed",
    "contracts:generate": "node scripts/generate.mjs",
    "contracts:check": "node scripts/contracts-check.mjs",
    "android:generate": "node scripts/android-client.mjs",
    "android:client-check": "node scripts/android-client.mjs --check",
    "android:check": "node scripts/android-gradle.mjs ktlintCheck assembleDebug assembleRelease",
    "android:build": "node scripts/android-gradle.mjs assembleDebug",
    "android:demo": "node scripts/build-android-demo.mjs",
    "check": "node scripts/check.mjs",
    "admin:dev": "pnpm --filter @rentaid/admin dev",
    "admin:build": "pnpm --filter @rentaid/admin build",
    "app:up": "docker compose -f infra/compose.yaml --profile app up -d --build --wait",
    "app:down": "docker compose -f infra/compose.yaml --profile app down",
    "web:dev": "pnpm --filter @rentaid/web dev",
    "web:build": "pnpm --filter @rentaid/web build",
    "demo:up": "node scripts/demo.mjs up",
    "demo:down": "node scripts/demo.mjs down",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:backup": "node scripts/demo.mjs backup",
    "demo:restore": "node scripts/demo.mjs restore",
    "test:unit": "node tests/run.mjs unit",
    "test:integration": "node tests/run.mjs integration",
    "test:e2e:web": "node tests/run.mjs e2e:web",
    "test:e2e:android": "node tests/run.mjs e2e:android",
    "test:e2e": "node tests/run.mjs e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
