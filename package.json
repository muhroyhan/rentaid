{
  "name": "rentaid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "db:up": "docker compose -f infra/compose.yaml up -d --wait postgres",
    "db:down": "docker compose -f infra/compose.yaml down",
    "api:dev": "go -C apps/api run ./cmd/rentaid serve",
    "api:build": "node scripts/build-api.mjs",
    "db:migrate": "go -C apps/api run ./cmd/rentaid migrate",
    "db:seed": "go -C apps/api run ./cmd/rentaid seed",
    "contracts:generate": "node scripts/generate.mjs",
    "contracts:check": "node scripts/contracts-check.mjs",
    "android:generate": "node scripts/android-client.mjs",
    "android:client-check": "node scripts/android-client.mjs --check",
    "android:check": "node scripts/android-gradle.mjs ktlintCheck testDebugUnitTest assembleDebug assembleRelease",
    "android:build": "node scripts/android-gradle.mjs assembleDebug",
    "android:demo": "node scripts/build-android-demo.mjs",
    "test": "node scripts/test-go.mjs",
    "check": "node scripts/check.mjs",
    "admin:dev": "pnpm --filter @rentaid/admin dev",
    "admin:build": "pnpm --filter @rentaid/admin build",
    "app:up": "docker compose -f infra/compose.yaml --profile app up -d --build --wait",
    "app:down": "docker compose -f infra/compose.yaml --profile app down",
    "test:admin-browser": "node scripts/test-admin-browser.mjs",
    "test:admin-content": "node scripts/test-admin-content.mjs",
    "test:admin-stores": "node scripts/test-admin-stores.mjs",
    "test:admin-categories": "node scripts/test-admin-categories.mjs",
    "test:admin-products": "node scripts/test-admin-products.mjs",
    "web:dev": "pnpm --filter @rentaid/web dev",
    "web:build": "pnpm --filter @rentaid/web build",
    "test:marketplace-account": "node scripts/test-marketplace-account.mjs",
    "test:vendor-products": "node scripts/test-vendor-products.mjs",
    "test:public-catalog": "node scripts/test-public-catalog.mjs",
    "test:catalog-errors": "node scripts/test-catalog-errors.mjs",
    "test:product-quote": "node scripts/test-product-quote.mjs",
    "test:checkout": "node scripts/test-checkout.mjs",
    "test:payment": "node scripts/test-payment.mjs",
    "test:cancellation": "node scripts/test-cancellation.mjs",
    "test:handover": "node scripts/test-handover.mjs",
    "test:return": "node scripts/test-return.mjs",
    "test:order-history": "node scripts/test-order-history.mjs",
    "test:android-vendor": "node scripts/test-android-vendor.mjs",
    "test:android-delivery": "node scripts/test-android-delivery.mjs",
    "test:stability": "node scripts/test-stability.mjs",
    "demo:up": "node scripts/demo.mjs up",
    "demo:down": "node scripts/demo.mjs down",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:backup": "node scripts/demo.mjs backup",
    "demo:restore": "node scripts/demo.mjs restore",
    "test:demo": "node scripts/test-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
