  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "example": "database_unavailable"
          },
          "message": {
            "type": "string",
            "example": "Database belum tersedia."
          }
        }
      },
      "Csrf": {
        "type": "object",
        "additionalProperties": false,
        "required": ["csrfToken"],
        "properties": {
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "email", "role"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "user"]
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "expiresAt"],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "csrfToken": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password", "client"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "client": {
            "type": "string",
            "enum": ["admin", "marketplace", "android"]
          }
        }
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rentaid_session",
        "description": "Browser session cookie; state-changing browser requests also require an allowed Origin and X-CSRF-Token."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Android session token."
      }
    }
  }
}
