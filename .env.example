APP_ENV=local
DATABASE_URL=postgres://rentaid:rentaid_local@localhost:5432/rentaid?sslmode=disable
HTTP_ADDR=127.0.0.1:8080

SESSION_TTL_DAYS=14
LOGIN_RATE_LIMIT=5
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

MEDIA_DIR=../../.artifacts/media
PAYMENT_SIMULATOR_ENABLED=true

# Optional Compose/demo selection (read from the terminal environment)
RENTAID_COMPOSE_PROJECT=rentaid
RENTAID_DB_PORT=5432
RENTAID_HTTP_PORT=8081
